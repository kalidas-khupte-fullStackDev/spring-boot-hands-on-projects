spring:
  application:
    name: gateway
  cloud:
    gateway:
      server:
        webflux:
          routes:
            - id: user-service
              uri: http://localhost:8082
              predicates:
                - name: Path
                  args:
                    patterns: /api/users/**

            - id: product-service
              uri: http://localhost:8081
              predicates:
                - name: Path
                  args:
                    patterns: /api/products/**

            - id: order-service
              uri: http://localhost:8083
              predicates:
                - name: Path
                  args:
                    patterns:
                      - /api/cart/**
                      - /api/orders/**

#Actuator Endpoints
management:
  endpoints:
    web:
      exposure:
        include: "*"
  tracing:
    sampling:
      probability: 1.0

eureka:
  client:
    serviceUrl:
      defaultZone: http://localhost:8761/eureka/
    register-with-eureka: true
    fetch-registry: true

logging:
  level:
    root: info
    org.springframework.cloud.gateway.route.RouteDefinitionLocator: INFO
    org.springframework.cloud.gateway: TRACE

server:
  port: 8080